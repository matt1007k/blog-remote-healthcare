---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="No encontrado — Postura & Teletrabajo" description="Página no encontrada.">
  <div class="mx-auto max-w-md py-16 text-center">
    <p class="font-display text-6xl">🪑</p>
    <h1 class="font-display mt-4 text-3xl">Tómate una pausa</h1>
    <p class="mt-2 opacity-70">Esta página no existe (o se estiró demasiado). Levántate, estira hombros 20 segundos y vuelve al inicio.</p>
    <a href="/" class="mt-6 inline-block rounded-xl bg-eucalyptus-700 px-5 py-2.5 text-sm font-semibold text-white">Volver al inicio</a>
  </div>
</BaseLayout>
