---
/**
 * BlogPostLayout.astro — Metadatos del artículo + slots de contenido.
 * <article> + <aside> semánticos; el layout no calcula nada (recibe props).
 */
import BaseLayout from './BaseLayout.astro';
import RelatedPosts from '../components/blog/RelatedPosts.astro';
import Comments from '../components/comments/Comments.astro';
import type { BlogPost } from '../core/domain/entities';
import type { ICommentAdapter } from '../core/domain/repositories';

interface Props {
  post: BlogPost;
  related: readonly BlogPost[];
  commentAdapter: ICommentAdapter;
}

const { post, related, commentAdapter } = Astro.props as Props;
const dateStr: string = post.pubDate.toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout title={`${post.title} — Postura & Teletrabajo`} description={post.description} canonicalPath={`/blog/${post.slug}/`}>
  <nav aria-label="Migas de pan" class="mb-6 text-sm opacity-70">
    <a href="/" class="hover:underline">Inicio</a> / <a href="/blog/" class="hover:underline">Blog</a> / <span aria-current="page">{post.title}</span>
  </nav>

  <article aria-labelledby="post-title" class="mx-auto max-w-3xl">
    <header>
      <div class="flex flex-wrap gap-2 text-xs">
        <span class="rounded-full bg-eucalyptus-700 px-3 py-1 font-semibold text-white">{post.category}</span>
        <span class="rounded-full border px-3 py-1">{post.difficulty}</span>
      </div>
      <h1 id="post-title" class="font-display mt-4 text-4xl leading-tight">{post.title}</h1>
      <p class="mt-3 text-lg opacity-80">{post.description}</p>
      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm opacity-70">
        <address class="not-italic">Por <span rel="author" class="font-medium">{post.author.name}</span>{post.author.role ? ` · ${post.author.role}` : ''}</address>
        <time datetime={post.pubDate.toISOString()}>{dateStr}</time>
        <span aria-label="Tiempo de lectura">⏱ {post.readingMinutes} min de lectura</span>
      </div>
      <ul aria-label="Etiquetas" class="mt-3 flex flex-wrap gap-2">
        {post.tags.map((tag: string) => (
          <li><a href={`/blog/?tag=${encodeURIComponent(tag)}`} class="rounded-full bg-eucalyptus-100 px-2.5 py-1 text-xs text-eucalyptus-800 hover:underline dark:bg-eucalyptus-800 dark:text-eucalyptus-100">#{tag}</a></li>
        ))}
      </ul>
    </header>

    <div class="prose-ergo mt-8 space-y-5 text-[1.05rem]">
      <slot />
    </div>

    <footer class="mt-10 rounded-2xl bg-eucalyptus-100 p-5 text-sm dark:bg-eucalyptus-900" role="note" aria-label="Aviso de salud">
      <strong>Nota de salud:</strong> si sientes hormigueo, dolor nocturno o pérdida de fuerza, pausa y consulta a un profesional. Este artículo es preventivo, no diagnóstico.
    </footer>
  </article>

  <div class="mx-auto max-w-3xl">
    <RelatedPosts posts={related} />
    <Comments adapter={commentAdapter} />
  </div>
</BaseLayout>
